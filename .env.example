# Supabase configuration (use .env.local for actual values).
# Standard names:
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Vercel Supabase integration aliases are also supported:
# WYY_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_WYY_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# WYY_SUPABASE_ANON_KEY=your-anon-key

# Database passwords, JWT secrets and service-role keys are not required by the app.
